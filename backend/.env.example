DATABASE_URL=postgresql+psycopg://evidence_app:replace-me@localhost:5432/digital_evidence_db
SECRET_KEY=generate-a-long-random-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIRECTORY=uploads
REPORT_DIRECTORY=reports
DEBUG=False
APP_NAME=Digital Evidence Integrity System
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Optional Google Identity Services web client ID. This public ID is also the backend token audience.
GOOGLE_CLIENT_ID=

# Optional SMTP delivery for password recovery and email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=True
